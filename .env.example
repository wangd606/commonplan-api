POSTGRES_DB=zhitong
AUTH_POSTGRES_DB=zhitong_auth
POSTGRES_USER=zhitong
POSTGRES_PASSWORD=zhitong
DATABASE_URL=postgresql+psycopg://zhitong:zhitong@db:5432/zhitong
AUTH_DATABASE_URL=postgresql+psycopg://zhitong:zhitong@db:5432/zhitong_auth
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=http://localhost:5173
AUTH_PUBLIC_URL=http://localhost:8001
AUTH_ISSUER=http://localhost:8001
AUTH_AUDIENCE=zhitong-api
AUTH_CLIENT_ID=zhitong-web
AUTH_INTERNAL_CLIENT_SECRET=replace-with-an-independent-long-random-value
BFF_TOKEN_ENCRYPTION_SECRET=replace-with-an-independent-long-random-value
BFF_CALLBACK_URL=http://localhost:8000/auth/google/complete
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SESSION_SECRET=replace-with-a-long-random-value
AUTH_SIGNING_KEY_ID=local-dev-1
ACCESS_TOKEN_MAX_AGE_SECONDS=900
REFRESH_TOKEN_MAX_AGE_SECONDS=2592000
BFF_SESSION_COOKIE_NAME=zhitong_web_session
OAUTH_STATE_COOKIE_NAME=zhitong_oauth_state
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
SESSION_MAX_AGE_SECONDS=604800
GITHUB_WEBHOOK_SECRET=
GITHUB_ALLOWED_OWNER_ID=
GITHUB_ALLOWED_OWNER_LOGIN=wangd606
GITHUB_WORKSPACE_ID=
GITHUB_HOOK_ID=
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_PUBLIC_URL=http://localhost:8000
OBJECT_STORAGE_SIGNING_SECRET=replace-with-a-long-random-value
# S3 settings are used when OBJECT_STORAGE_DRIVER=s3.
OBJECT_STORAGE_ENDPOINT=https://s3.amazonaws.com
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://s3.amazonaws.com
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=commonplan-attachments
OBJECT_STORAGE_ACCESS_KEY=commonplan
OBJECT_STORAGE_SECRET_KEY=
ATTACHMENT_UPLOAD_MAX_BYTES=26214400
ATTACHMENT_URL_TTL_SECONDS=900
# Local production profile. On x86_64 use
# ghcr.io/huggingface/text-embeddings-inference:cpu-1.9 instead.
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9
INGESTION_EMBEDDING_PROVIDER=model_gateway
INGESTION_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
INGESTION_EMBEDDING_MODEL_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
INGESTION_EMBEDDING_DIMENSIONS=1024
INGESTION_EMBEDDING_BASE_URL=http://embedding-service
INGESTION_EMBEDDING_BATCH_SIZE=3
TEI_MAX_BATCH_TOKENS=1024
TEI_MAX_CONCURRENT_REQUESTS=8
TEI_TOKENIZATION_WORKERS=2
INGESTION_EMBEDDING_TIMEOUT_SECONDS=120
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:v1.90.2
# Local-only shared key. Production must use Secret Manager and a restricted
# service/virtual key instead of the LiteLLM admin key.
LITELLM_MASTER_KEY=sk-local-commonplan-change-me
MODEL_GATEWAY_BASE_URL=http://model-gateway:4000/v1
MODEL_GATEWAY_API_KEY=sk-local-commonplan-change-me
MODEL_GATEWAY_EMBEDDING_ALIAS=commonplan-embedding-v1
TEI_API_KEY=not-required-local
# Optional MCP gateway profile. This is deliberately a different credential
# and deployment unit from the model gateway, even though both run LiteLLM.
MCP_GATEWAY_MASTER_KEY=sk-local-commonplan-mcp-change-me
INGESTION_DOCLING_MAX_PAGES=500
INGESTION_CHUNK_TOKENS=300
INGESTION_CHUNK_OVERLAP_TOKENS=50
INGESTION_MAX_ATTEMPTS=5
INGESTION_ALLOW_UNSCANNED=true
OPENAI_API_KEY=
# Durable knowledge event bus. Local Docker uses Redpanda; production may use
# any Kafka-compatible provider by changing only these connection settings.
EVENT_BUS_BOOTSTRAP_SERVERS=redpanda:9092
EVENT_BUS_TOPIC=commonplan.knowledge.v1
EVENT_BUS_DLQ_TOPIC=commonplan.knowledge.dlq.v1
EVENT_BUS_CONSUMER_GROUP=commonplan-knowledge-indexer-v1
EVENT_BUS_MAX_POLL_INTERVAL_SECONDS=1800
EVENT_BUS_SECURITY_PROTOCOL=PLAINTEXT
EVENT_BUS_SASL_MECHANISM=SCRAM-SHA-256
EVENT_BUS_SASL_USERNAME=
EVENT_BUS_SASL_PASSWORD=
